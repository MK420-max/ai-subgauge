<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>AISubGauge</RootNamespace>
    <AssemblyName>AISubGauge</AssemblyName>
    <Product>AI SubGauge</Product>
    <Title>AI SubGauge</Title>
    <Version>1.2.0</Version>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <ApplicationIcon>../../../shared/brand/AISubGauge-light.ico</ApplicationIcon>
    <!-- Keep the NuGet lock graph identical for build and single-file publish (ILLink analyzers). -->
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IncludePrivateLogos)' == 'true' And Exists('../../../shared/private-logos/grokbot-head.png')">
    <DefineConstants>$(DefineConstants);PRIVATE_GROK_LOGO</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Compile Remove="UI/BottomStrip.cs" />
    <EmbeddedResource Include="../../../shared/theme.json" LogicalName="AISubGauge.shared.theme.json" />
    <EmbeddedResource Include="../../../shared/brand/app-*-1024.png;../../../shared/brand/tray-mono*.png;../../../shared/brand/AISubGauge-*.ico">
      <LogicalName>AISubGauge.shared.brand.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../../../shared/running-processes.json" LogicalName="AISubGauge.shared.running-processes.json" />
    <EmbeddedResource Include="../../../shared/i18n/*.json">
      <LogicalName>AISubGauge.shared.i18n.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../../../shared/logos/*.png">
      <LogicalName>WindowsQuotaTray.assets.logos.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../../../shared/private-logos/grokbot-head.png" Condition="'$(IncludePrivateLogos)' == 'true' And Exists('../../../shared/private-logos/grokbot-head.png')"
                      LogicalName="WindowsQuotaTray.assets.logos.grokbot-head.png" />
    <EmbeddedResource Include="../../../shared/logos/dark/*.png">
      <LogicalName>WindowsQuotaTray.assets.logos.dark.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <Content Include="../../../shared/logos/LICENSE-LobeHub.txt" Link="assets/logos/LICENSE-LobeHub.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
